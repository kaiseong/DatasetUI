{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lerobot:dataset-editor:lerobot-v30",
  "title": "LeRobot v3.0 meta/info.json contract",
  "description": "Executable contract for the dataset format loaded and written by official LeRobot v0.6.0. Language columns are the v3.1 extension defined separately.",
  "type": "object",
  "required": [
    "codebase_version",
    "robot_type",
    "total_episodes",
    "total_frames",
    "total_tasks",
    "chunks_size",
    "data_files_size_in_mb",
    "video_files_size_in_mb",
    "fps",
    "splits",
    "data_path",
    "video_path",
    "features"
  ],
  "properties": {
    "codebase_version": { "const": "v3.0" },
    "robot_type": { "type": ["string", "null"] },
    "total_episodes": { "type": "integer", "minimum": 0 },
    "total_frames": { "type": "integer", "minimum": 0 },
    "total_tasks": { "type": "integer", "minimum": 0 },
    "chunks_size": { "type": "integer", "minimum": 1 },
    "data_files_size_in_mb": { "type": "integer", "minimum": 1 },
    "video_files_size_in_mb": { "type": "integer", "minimum": 1 },
    "fps": { "type": "integer", "minimum": 1 },
    "splits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
    },
    "data_path": { "const": "data/chunk-{chunk_index:03d}/file-{file_index:03d}.parquet" },
    "video_path": {
      "type": ["string", "null"],
      "enum": ["videos/{video_key}/chunk-{chunk_index:03d}/file-{file_index:03d}.mp4", null]
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/feature" }
    },
    "tools": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/tool_schema" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["dtype", "shape", "names"],
      "properties": {
        "dtype": {
          "type": "string",
          "enum": ["float16", "float32", "float64", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "bool", "string", "image", "video", "language"]
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "names": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "info": { "type": "object" }
      },
      "additionalProperties": true
    },
    "tool_schema": {
      "type": "object",
      "required": ["type", "function"],
      "properties": {
        "type": { "const": "function" },
        "function": {
          "type": "object",
          "required": ["name", "parameters"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "parameters": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
