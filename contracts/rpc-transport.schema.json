{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lerobot:dataset-editor:rpc-transport-v1",
  "title": "DatasetUI framed JSON-RPC 2.0 transport",
  "description": "Stdio protocol between the sandboxed Electron shell and the local Python backend.",
  "x-framing": {
    "header": "Content-Length",
    "delimiter": "\\r\\n\\r\\n",
    "encoding": "utf-8",
    "max_content_length": 16777216
  },
  "x-protocol-version": 1,
  "x-methods": ["initialize", "report.get", "shutdown", "system.ping"],
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/notification" }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        { "type": "integer" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "params": {
      "oneOf": [
        { "type": "object" },
        { "type": "array" }
      ]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "enum": ["initialize", "report.get", "shutdown", "system.ping"] },
        "params": { "$ref": "#/$defs/params" }
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {}
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string", "minLength": 1 },
            "data": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "enum": ["server.ready", "server.exit"] },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
