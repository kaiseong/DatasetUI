FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY datasetui ./datasetui

# The v2.1 compatibility writer is isolated here so future legacy LeRobot pins
# cannot affect the API or the v3 worker environment.
CMD ["rq", "worker", "--url", "redis://redis:6379/0", "--serializer", "rq.serializers.JSONSerializer", "converter-v21"]
