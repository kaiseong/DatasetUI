# Dataset host URL (defaults to https://huggingface.co/datasets)
# DATASET_URL=https://huggingface.co/datasets

# DatasetUI deployment. Copy this file to .env on the RTX 6000 host.
DATASETUI_HOST=192.168.0.3
# Optional comma-separated browser origins when the UI is served elsewhere.
# DATASETUI_ALLOWED_ORIGINS=https://192.168.0.3
DATASETUI_DATA_ROOT=/data/datasetui
DATASETUI_NAS_ROOT=/mnt/datasetui-nas/DatasetUI
DATASETUI_TZ=Asia/Seoul
DATASETUI_UID=1000
DATASETUI_GID=1000
DATASETUI_JOB_TIMEOUT_SECONDS=900
DATASETUI_IO_JOB_TIMEOUT_SECONDS=86400
DATASETUI_JOB_LEASE_SECONDS=120
DATASETUI_JOB_HEARTBEAT_SECONDS=20
DATASETUI_HF_IMPORT_MAX_BYTES=2000000000000
DATASETUI_SCAN_MAX_DEPTH=6

# Server-only fine-grained read token for private rainbowrobotics datasets.
# Never expose this value through NEXT_PUBLIC_* variables or the browser UI.
# HF_READ_TOKEN=hf_...

# Annotation backend (optional). When set, the Annotations tab persists
# edits, rewrites parquet shards with `language_persistent` + `language_events`
# columns (lerobot#3467 / #3471), and can push to the HF Hub. When unset, the
# Annotations tab is read/edit-only with sessionStorage persistence.
# NEXT_PUBLIC_ANNOTATE_BACKEND_URL=http://127.0.0.1:7861
