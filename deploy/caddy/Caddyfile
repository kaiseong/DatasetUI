{
	admin off
	default_sni {$DATASETUI_HOST}
	skip_install_trust
}

http://{$DATASETUI_HOST} {
	redir https://{$DATASETUI_HOST}{uri} 308
}

https://{$DATASETUI_HOST} {
	tls internal
	encode zstd gzip
	rewrite / /library

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
	}

	# Only the versioned Workbench boundary exposes write/export operations.
	@api_health path /api/health
	handle @api_health {
		reverse_proxy api:7861
	}

	# Versioned Workbench APIs are the persistent-state boundary introduced
	# in Phase 2. They never accept raw commands or credentials in job payloads.
	@segmentation_api path /api/v1/segmentation/*
	handle @segmentation_api {
		request_body {
			max_size 20MB
		}
		reverse_proxy api:7861
	}

	@workbench_api path /api/v1/*
	handle @workbench_api {
		reverse_proxy api:7861
	}

	@private_api path /api/dataset/* /api/episodes/* /api/export /api/push_to_hub
	handle @private_api {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
